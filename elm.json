{
    "type": "package",
    "name": "billstclair/elm-webxr",
    "summary": "elm-webxr is an Elm interface to WebXR",
    "license": "MIT",
    "version": "1.0.0",
    "exposed-modules": [
      "WebXR",
      "WebXR.Types"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "NoRedInk/elm-json-decode-pipeline": "1.0.1 <= v < 2.0.0",
        "elm/browser": "1.0.2 <= v < 2.0.0",
        "elm/core": "1.0.0 <= v < 2.0.0",
        "elm/html": "1.0.1 <= v < 2.0.0",
        "elm/http": "2.0.0 <= v < 3.0.0",
        "elm/json": "1.1.3 <= v < 2.0.0",
        "elm/time": "1.0.0 <= v < 2.0.0",
        "elm/url": "1.0.0 <= v < 2.0.0",
        "ianmackenzie/elm-units": "2.10.0 <= v < 3.0.0",
        "mgold/elm-nonempty-list": "4.2.0 <= v < 5.0.0"
    },
    "test-dependencies": {}
